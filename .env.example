# ----------------------------------------------------------------------------
# Servidor
# ----------------------------------------------------------------------------
PORT=3333
NODE_ENV=development

# ----------------------------------------------------------------------------
# Postgres do Supabase
# Supabase Dashboard → Project Settings → Database → Connection string
# Use o "Connection pooling" (Transaction mode, porta 6543) para apps serverless
# ou o "Direct connection" (porta 5432) para um servidor de longa duração.
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ----------------------------------------------------------------------------
# Segredo do JWT do Supabase Auth (HS256)
# Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
# ----------------------------------------------------------------------------
SUPABASE_JWT_SECRET=troque-por-seu-jwt-secret

# ----------------------------------------------------------------------------
# Supabase Auth — usados pelas rotas /auth/signup e /auth/signin
# ----------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase Dashboard → Project Settings → API → Project API keys → "anon public"
SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# APENAS DEV: injeta um user_id fixo e ignora o JWT, para testar sem gerar token.
# Deixe VAZIO em produção. Só tem efeito quando NODE_ENV != production.
# ----------------------------------------------------------------------------
AUTH_DEV_BYPASS_USER_ID=

# ----------------------------------------------------------------------------
# CORS (produção) — origens do frontend liberadas, separadas por vírgula.
# Só é aplicado quando NODE_ENV=production. Ex.: https://financas.vercel.app
# ----------------------------------------------------------------------------
CORS_ORIGIN=

# ----------------------------------------------------------------------------
# Google Gemini — usado no scan de recibos (POST /transactions/scan).
# Pegue a chave GRÁTIS em: aistudio.google.com → Get API key
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
